<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fc.match.mapper.TeamLogoMapper">

    <resultMap type="TeamLogo" id="TeamLogoResult">
        <result property="id"          column="id"          />
        <result property="teamName"    column="team_name"   />
        <result property="logoUrl"     column="logo_url"    />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
        <result property="delFlag"     column="del_flag"    />
    </resultMap>

    <sql id="selectTeamLogoVo">
        select id, team_name, logo_url, create_by, create_time, update_by, update_time, remark, del_flag from football_team_logo
    </sql>

    <select id="selectTeamLogoList" parameterType="TeamLogo" resultMap="TeamLogoResult">
        <include refid="selectTeamLogoVo"/>
        <where>
            <if test="teamName != null  and teamName != ''"> and team_name like concat('%', #{teamName}, '%')</if>
            <if test="logoUrl != null  and logoUrl != ''"> and logo_url = #{logoUrl}</if>
            and del_flag = '0'
        </where>
        order by id asc
    </select>

    <select id="selectTeamLogoByName" parameterType="String" resultMap="TeamLogoResult">
        <include refid="selectTeamLogoVo"/>
        where team_name = #{teamName}
          and del_flag = '0'
        limit 1
    </select>

    <select id="selectTeamLogoById" parameterType="Long" resultMap="TeamLogoResult">
        <include refid="selectTeamLogoVo"/>
        where id = #{id}
    </select>

    <insert id="insertTeamLogo" parameterType="TeamLogo" useGeneratedKeys="true" keyProperty="id">
        insert into football_team_logo
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamName != null and teamName != ''">team_name,</if>
            <if test="logoUrl != null and logoUrl != ''">logo_url,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamName != null and teamName != ''">#{teamName},</if>
            <if test="logoUrl != null and logoUrl != ''">#{logoUrl},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateTeamLogo" parameterType="TeamLogo">
        update football_team_logo
        <trim prefix="SET" suffixOverrides=",">
            <if test="teamName != null and teamName != ''">team_name = #{teamName},</if>
            <if test="logoUrl != null">logo_url = #{logoUrl},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteTeamLogoByIds" parameterType="Long">
        update football_team_logo set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
