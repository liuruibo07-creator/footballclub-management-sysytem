<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fc.match.mapper.LeagueTeamMapper">

    <resultMap type="LeagueTeam" id="LeagueTeamResult">
        <result property="id"            column="id"            />
        <result property="teamName"      column="team_name"     />
        <result property="logoUrl"       column="logo_url"      />
        <result property="leagueName"    column="league_name"   />
        <result property="division"      column="division"      />
        <result property="status"        column="status"        />
        <result property="dissolveFlag"  column="dissolve_flag" />
        <result property="managerPhone"  column="manager_phone" />
        <result property="liaisonAdmin"  column="liaison_admin" />
        <result property="createBy"      column="create_by"     />
        <result property="createTime"    column="create_time"   />
        <result property="updateBy"      column="update_by"     />
        <result property="updateTime"    column="update_time"   />
        <result property="remark"        column="remark"        />
        <result property="delFlag"       column="del_flag"      />
    </resultMap>

    <sql id="selectLeagueTeamVo">
        select id, team_name, logo_url, league_name, division, status, dissolve_flag, manager_phone, liaison_admin, create_by, create_time, update_by, update_time, remark, del_flag from football_league_team
    </sql>

    <select id="selectLeagueTeamList" parameterType="LeagueTeam" resultMap="LeagueTeamResult">
        <include refid="selectLeagueTeamVo"/>
        <where>
            <if test="teamName != null  and teamName != ''"> and team_name like concat('%', #{teamName}, '%')</if>
            <if test="leagueName != null  and leagueName != ''"> and league_name = #{leagueName}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            and del_flag = '0'
        </where>
        order by id asc
    </select>

    <select id="selectLeagueTeamAll" resultMap="LeagueTeamResult">
        <include refid="selectLeagueTeamVo"/>
        where del_flag = '0'
        order by id asc
    </select>

    <select id="selectLeagueTeamByName" parameterType="String" resultMap="LeagueTeamResult">
        <include refid="selectLeagueTeamVo"/>
        where team_name = #{teamName}
        limit 1
    </select>

    <select id="selectLeagueTeamById" parameterType="Long" resultMap="LeagueTeamResult">
        <include refid="selectLeagueTeamVo"/>
        where id = #{id}
    </select>

    <insert id="insertLeagueTeam" parameterType="LeagueTeam" useGeneratedKeys="true" keyProperty="id">
        insert into football_league_team
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamName != null and teamName != ''">team_name,</if>
            <if test="logoUrl != null and logoUrl != ''">logo_url,</if>
            <if test="leagueName != null and leagueName != ''">league_name,</if>
            <if test="division != null and division != ''">division,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="dissolveFlag != null and dissolveFlag != ''">dissolve_flag,</if>
            <if test="managerPhone != null">manager_phone,</if>
            <if test="liaisonAdmin != null">liaison_admin,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamName != null and teamName != ''">#{teamName},</if>
            <if test="logoUrl != null and logoUrl != ''">#{logoUrl},</if>
            <if test="leagueName != null and leagueName != ''">#{leagueName},</if>
            <if test="division != null and division != ''">#{division},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="dissolveFlag != null and dissolveFlag != ''">#{dissolveFlag},</if>
            <if test="managerPhone != null">#{managerPhone},</if>
            <if test="liaisonAdmin != null">#{liaisonAdmin},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateLeagueTeam" parameterType="LeagueTeam">
        update football_league_team
        <trim prefix="SET" suffixOverrides=",">
            <if test="teamName != null and teamName != ''">team_name = #{teamName},</if>
            <if test="logoUrl != null and logoUrl != ''">logo_url = #{logoUrl},</if>
            <if test="leagueName != null and leagueName != ''">league_name = #{leagueName},</if>
            <if test="division != null and division != ''">division = #{division},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="dissolveFlag != null and dissolveFlag != ''">dissolve_flag = #{dissolveFlag},</if>
            <if test="managerPhone != null">manager_phone = #{managerPhone},</if>
            <if test="liaisonAdmin != null">liaison_admin = #{liaisonAdmin},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteLeagueTeamByIds" parameterType="Long">
        update football_league_team set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
