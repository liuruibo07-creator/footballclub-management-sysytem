<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fc.match.mapper.MatchMapper">
    
    <resultMap type="Match" id="MatchResult">
        <result property="id"    column="id"    />
        <result property="season"    column="season"    />
        <result property="roundNo"    column="round_no"    />
        <result property="matchDate"    column="match_date"    />
        <result property="homeTeam"    column="home_team"    />
        <result property="awayTeam"    column="away_team"    />
        <result property="homeScore"    column="home_score"    />
        <result property="awayScore"    column="away_score"    />
        <result property="status"    column="status"    />
        <result property="venue"    column="venue"    />
        <result property="competitionType"    column="competition_type"    />
        <result property="competitionName"    column="competition_name"    />
        <result property="sourceUrl"    column="source_url"    />
        <result property="sourceAsOf"    column="source_as_of"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMatchVo">
        select id, season, round_no, match_date, home_team, away_team, home_score, away_score, status, venue, competition_type, competition_name, source_url, source_as_of, create_by, create_time, update_by, update_time, del_flag, remark from football_match
    </sql>

    <select id="selectMatchList" parameterType="Match" resultMap="MatchResult">
        <include refid="selectMatchVo"/>
        <where>  
            <if test="status != null "> and status = #{status}</if>
            <if test="competitionName != null  and competitionName != ''"> and competition_name like concat('%', #{competitionName}, '%')</if>
        </where>
    </select>
    
    <select id="selectMatchById" parameterType="Long" resultMap="MatchResult">
        <include refid="selectMatchVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertMatch" parameterType="Match" useGeneratedKeys="true" keyProperty="id">
        insert into football_match
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="season != null and season != ''">season,</if>
            <if test="roundNo != null">round_no,</if>
            <if test="matchDate != null">match_date,</if>
            <if test="homeTeam != null and homeTeam != ''">home_team,</if>
            <if test="awayTeam != null and awayTeam != ''">away_team,</if>
            <if test="homeScore != null">home_score,</if>
            <if test="awayScore != null">away_score,</if>
            <if test="status != null">status,</if>
            <if test="venue != null">venue,</if>
            <if test="competitionType != null">competition_type,</if>
            <if test="competitionName != null and competitionName != ''">competition_name,</if>
            <if test="sourceUrl != null">source_url,</if>
            <if test="sourceAsOf != null">source_as_of,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="season != null and season != ''">#{season},</if>
            <if test="roundNo != null">#{roundNo},</if>
            <if test="matchDate != null">#{matchDate},</if>
            <if test="homeTeam != null and homeTeam != ''">#{homeTeam},</if>
            <if test="awayTeam != null and awayTeam != ''">#{awayTeam},</if>
            <if test="homeScore != null">#{homeScore},</if>
            <if test="awayScore != null">#{awayScore},</if>
            <if test="status != null">#{status},</if>
            <if test="venue != null">#{venue},</if>
            <if test="competitionType != null">#{competitionType},</if>
            <if test="competitionName != null and competitionName != ''">#{competitionName},</if>
            <if test="sourceUrl != null">#{sourceUrl},</if>
            <if test="sourceAsOf != null">#{sourceAsOf},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMatch" parameterType="Match">
        update football_match
        <trim prefix="SET" suffixOverrides=",">
            <if test="season != null and season != ''">season = #{season},</if>
            <if test="roundNo != null">round_no = #{roundNo},</if>
            <if test="matchDate != null">match_date = #{matchDate},</if>
            <if test="homeTeam != null and homeTeam != ''">home_team = #{homeTeam},</if>
            <if test="awayTeam != null and awayTeam != ''">away_team = #{awayTeam},</if>
            <if test="homeScore != null">home_score = #{homeScore},</if>
            <if test="awayScore != null">away_score = #{awayScore},</if>
            <if test="status != null">status = #{status},</if>
            <if test="venue != null">venue = #{venue},</if>
            <if test="competitionType != null">competition_type = #{competitionType},</if>
            <if test="competitionName != null and competitionName != ''">competition_name = #{competitionName},</if>
            <if test="sourceUrl != null">source_url = #{sourceUrl},</if>
            <if test="sourceAsOf != null">source_as_of = #{sourceAsOf},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMatchById" parameterType="Long">
        delete from football_match where id = #{id}
    </delete>

    <delete id="deleteMatchByIds" parameterType="String">
        delete from football_match where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectSeasonStats" resultType="java.util.HashMap">
        SELECT
            SUM(CASE
                WHEN home_team = '天津津门虎' AND home_score &gt; away_score THEN 1
                WHEN away_team = '天津津门虎' AND away_score &gt; home_score THEN 1
                ELSE 0
            END) AS wins,
            SUM(CASE
                WHEN (home_team = '天津津门虎' OR away_team = '天津津门虎') AND home_score = away_score THEN 1
                ELSE 0
            END) AS draws,
            SUM(CASE
                WHEN home_team = '天津津门虎' AND home_score &lt; away_score THEN 1
                WHEN away_team = '天津津门虎' AND away_score &lt; home_score THEN 1
                ELSE 0
            END) AS losses,
            COALESCE(SUM(CASE
                WHEN home_team = '天津津门虎' AND home_score &gt; away_score THEN 3
                WHEN away_team = '天津津门虎' AND away_score &gt; home_score THEN 3
                WHEN (home_team = '天津津门虎' OR away_team = '天津津门虎') AND home_score = away_score THEN 1
                ELSE 0
            END), 0) AS points
        FROM football_match
        WHERE status = 1
          AND del_flag = '0'
          AND (home_team = '天津津门虎' OR away_team = '天津津门虎')
    </select>

    <select id="selectRecentMatches" resultType="java.util.HashMap">
        SELECT
            round_no AS roundNo,
            match_date AS matchDate,
            home_score AS homeScore,
            away_score AS awayScore,
            home_team AS homeTeam,
            away_team AS awayTeam
        FROM football_match
        WHERE status = 1
          AND del_flag = '0'
          AND (home_team = '天津津门虎' OR away_team = '天津津门虎')
        ORDER BY match_date DESC
        LIMIT 5
    </select>
</mapper>