<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fc.system.mapper.FootballTrainingMapper">
    
    <resultMap type="FootballTraining" id="FootballTrainingResult">
        <result property="id"    column="id"    />
        <result property="season"    column="season"    />
        <result property="title"    column="title"    />
        <result property="trainingType"    column="training_type"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="venue"    column="venue"    />
        <result property="description"    column="description"    />
        <result property="trainingGoal"    column="training_goal"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="participantCount"    column="participant_count"    />
        <result property="attendanceRate"    column="attendance_rate"    />
    </resultMap>

    <resultMap id="FootballTrainingFootballTrainingPlayerResult" type="FootballTraining" extends="FootballTrainingResult">
        <collection property="footballTrainingPlayerList" notNullColumn="sub_id" javaType="java.util.List" resultMap="FootballTrainingPlayerResult" />
    </resultMap>

    <resultMap type="FootballTrainingPlayer" id="FootballTrainingPlayerResult">
        <result property="id"    column="sub_id"    />
        <result property="trainingId"    column="sub_training_id"    />
        <result property="playerId"    column="sub_player_id"    />
        <result property="attendanceStatus"    column="sub_attendance_status"    />
        <result property="createTime"    column="sub_create_time"    />
        <result property="playerName"    column="sub_player_name"    />
        <result property="position"    column="sub_position"    />
    </resultMap>

    <sql id="selectFootballTrainingVo">
        select id, season, title, training_type, start_time, end_time, venue, description, training_goal, status, create_by, create_time, update_by, update_time, del_flag, remark from football_training
    </sql>

    <select id="selectFootballTrainingList" parameterType="FootballTraining" resultMap="FootballTrainingResult">
        select a.id, a.season, a.title, a.training_type, a.start_time, a.end_time, a.venue,
               a.description, a.training_goal, a.status, a.create_by, a.create_time,
               a.update_by, a.update_time, a.del_flag, a.remark,
               (SELECT COUNT(*) FROM football_training_player WHERE training_id = a.id) AS participant_count,
               (SELECT CASE WHEN COUNT(*) = 0 THEN '0%'
                            ELSE CONCAT(ROUND(SUM(CASE WHEN attendance_status = 1 THEN 1 ELSE 0 END) * 100.0 / COUNT(*)), '%')
                       END
                FROM football_training_player WHERE training_id = a.id) AS attendance_rate
        from football_training a
        <where>  
            <if test="title != null  and title != ''"> and a.title like concat('%', #{title}, '%')</if>
            <if test="trainingType != null "> and a.training_type = #{trainingType}</if>
            <if test="startTime != null "> and a.start_time = #{startTime}</if>
            <if test="status != null "> and a.status = #{status}</if>
        </where>
        order by a.start_time asc
    </select>
    
    <select id="selectFootballTrainingById" parameterType="Long" resultMap="FootballTrainingFootballTrainingPlayerResult">
        select a.id, a.season, a.title, a.training_type, a.start_time, a.end_time, a.venue, a.description, a.training_goal, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.del_flag, a.remark,
 b.id as sub_id, b.training_id as sub_training_id, b.player_id as sub_player_id, b.attendance_status as sub_attendance_status, b.create_time as sub_create_time,
 p.name_cn as sub_player_name, p.position as sub_position
        from football_training a
        left join football_training_player b on b.training_id = a.id
        left join football_player p on p.id = b.player_id
        where a.id = #{id}
    </select>
        
    <insert id="insertFootballTraining" parameterType="FootballTraining" useGeneratedKeys="true" keyProperty="id">
        insert into football_training
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="season != null">season,</if>
            <if test="title != null">title,</if>
            <if test="trainingType != null">training_type,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="venue != null">venue,</if>
            <if test="description != null">description,</if>
            <if test="trainingGoal != null">training_goal,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="season != null">#{season},</if>
            <if test="title != null">#{title},</if>
            <if test="trainingType != null">#{trainingType},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="venue != null">#{venue},</if>
            <if test="description != null">#{description},</if>
            <if test="trainingGoal != null">#{trainingGoal},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateFootballTraining" parameterType="FootballTraining">
        update football_training
        <trim prefix="SET" suffixOverrides=",">
            <if test="season != null">season = #{season},</if>
            <if test="title != null">title = #{title},</if>
            <if test="trainingType != null">training_type = #{trainingType},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="venue != null">venue = #{venue},</if>
            <if test="description != null">description = #{description},</if>
            <if test="trainingGoal != null">training_goal = #{trainingGoal},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFootballTrainingById" parameterType="Long">
        delete from football_training where id = #{id}
    </delete>

    <delete id="deleteFootballTrainingByIds" parameterType="String">
        delete from football_training where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteFootballTrainingPlayerByTrainingIds" parameterType="String">
        delete from football_training_player where training_id in 
        <foreach item="trainingId" collection="array" open="(" separator="," close=")">
            #{trainingId}
        </foreach>
    </delete>

    <delete id="deleteFootballTrainingPlayerByTrainingId" parameterType="Long">
        delete from football_training_player where training_id = #{trainingId}
    </delete>

    <insert id="batchFootballTrainingPlayer">
        insert into football_training_player( id, training_id, player_id, attendance_status, create_time) values
		<foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.trainingId}, #{item.playerId}, #{item.attendanceStatus}, #{item.createTime})
        </foreach>
    </insert>
</mapper>