<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    Tables used in this mapper:
    - football_schedule_event (id, match_id, training_id, title, event_type, start_time, end_time, location, description, status, create_by, create_time, update_by, update_time, del_flag, remark)
    - football_schedule_player (id, event_id, player_id, create_time)
-->
<mapper namespace="com.fc.system.mapper.FootballScheduleEventMapper">
    
    <resultMap type="FootballScheduleEvent" id="FootballScheduleEventResult">
        <result property="id"    column="id"    />
        <result property="matchId"    column="match_id"    />
        <result property="trainingId"    column="training_id"    />
        <result property="title"    column="title"    />
        <result property="eventType"    column="event_type"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="location"    column="location"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="FootballScheduleEventFootballSchedulePlayerResult" type="FootballScheduleEvent" extends="FootballScheduleEventResult">
        <collection property="footballSchedulePlayerList" notNullColumn="sub_id" javaType="java.util.List" resultMap="FootballSchedulePlayerResult" />
    </resultMap>

    <resultMap type="FootballSchedulePlayer" id="FootballSchedulePlayerResult">
        <result property="id"    column="sub_id"    />
        <result property="eventId"    column="sub_event_id"    />
        <result property="playerId"    column="sub_player_id"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectFootballScheduleEventVo">
        select id, match_id, training_id, title, event_type, start_time, end_time, location, description, status, create_by, create_time, update_by, update_time, del_flag, remark from football_schedule_event
    </sql>

    <select id="selectFootballScheduleEventList" parameterType="FootballScheduleEvent" resultMap="FootballScheduleEventResult">
        <include refid="selectFootballScheduleEventVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="eventType != null  and eventType != ''"> and event_type = #{eventType}</if>
            <if test="beginStartTime != null and beginStartTime != '' and endStartTime != null and endStartTime != ''"> and start_time between #{beginStartTime} and #{endStartTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by start_time asc, id asc
    </select>

    <select id="selectPendingScheduleEvents" resultMap="FootballScheduleEventResult">
        <include refid="selectFootballScheduleEventVo"/>
        where status = '0'
          and del_flag = '0'
        order by start_time asc, id asc
        limit #{limit}
    </select>

    <select id="countPendingScheduleEvents" resultType="long">
        select count(1)
        from football_schedule_event
        where status = '0'
          and del_flag = '0'
    </select>
    
    <select id="selectFootballScheduleEventById" parameterType="Long" resultMap="FootballScheduleEventFootballSchedulePlayerResult">
        select a.id, a.match_id, a.training_id, a.title, a.event_type, a.start_time, a.end_time, a.location, a.description, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.del_flag, a.remark,
 b.id as sub_id, b.event_id as sub_event_id, b.player_id as sub_player_id, b.create_time as sub_create_time
        from football_schedule_event a
        left join football_schedule_player b on b.event_id = a.id
        where a.id = #{id}
    </select>
        
    <insert id="insertFootballScheduleEvent" parameterType="FootballScheduleEvent" useGeneratedKeys="true" keyProperty="id">
        insert into football_schedule_event
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="matchId != null">match_id,</if>
            <if test="trainingId != null">training_id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="eventType != null and eventType != ''">event_type,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="location != null">location,</if>
            <if test="description != null">description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="matchId != null">#{matchId},</if>
            <if test="trainingId != null">#{trainingId},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="eventType != null and eventType != ''">#{eventType},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="location != null">#{location},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateFootballScheduleEvent" parameterType="FootballScheduleEvent">
        update football_schedule_event
        <trim prefix="SET" suffixOverrides=",">
            <if test="matchId != null">match_id = #{matchId},</if>
            <if test="trainingId != null">training_id = #{trainingId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="eventType != null and eventType != ''">event_type = #{eventType},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="location != null">location = #{location},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFootballScheduleEventById" parameterType="Long">
        delete from football_schedule_event where id = #{id}
    </delete>

    <delete id="deleteFootballScheduleEventByIds" parameterType="String">
        delete from football_schedule_event where id in 
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteFootballSchedulePlayerByEventIds" parameterType="String">
        delete from football_schedule_player where event_id in 
        <foreach item="eventId" collection="ids" open="(" separator="," close=")">
            #{eventId}
        </foreach>
    </delete>

    <delete id="deleteFootballSchedulePlayerByEventId" parameterType="Long">
        delete from football_schedule_player where event_id = #{eventId}
    </delete>

    <insert id="batchFootballSchedulePlayer">
        insert into football_schedule_player( id, event_id, player_id, create_time) values
		<foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.eventId}, #{item.playerId}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
